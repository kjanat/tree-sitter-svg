{
	"extends": "https://raw.githubusercontent.com/kjanat/kjanat/469c487/configs/dprint.remote.json",
	"excludes": ["tree-sitter.json", "src/*.json", "test/**", "**/w3/*.svg", "*.fixture.svg", "fixtures/**"],
	"exec": {
		"associations": ["*.rs", "*.toml"],
		"commands": [
			{ "command": "rustfmt --edition 2024", "exts": ["rs"] },
			{ "command": "bunx tombi format - --stdin-filename {{file_path}}", "exts": ["toml"] },
		],
	},
	"plugins": [
		"https://plugins.dprint.dev/exec-0.6.2.json@df98f54ffd3092b8a841aedd6d098a2651f16d0a796a40535774f1a8b4b9d463",
	],
}
